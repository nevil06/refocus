<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Black Shadow: Offset 4dp right, 4dp bottom -->
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/brutal_shadow" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Top Timer Card Surface with Neon Mint Border -->
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_container" />
            <stroke android:width="2.5dp" android:color="@color/neon_mint" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
